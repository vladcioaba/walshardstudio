// Walshard Studio — Windows resources (icon + version info).
#include "resource.h"
#include "windows.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)

// axmol's GLFW backend loads the window icon by this name.
GLFW_ICON           ICON                    "res\\game.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Walshard Studio"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "Walshard"
            VALUE "OriginalFilename", "Walshard.exe"
            VALUE "ProductName", "Walshard Studio"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_PROJNAME            "Walshard Studio"
END
